{
  "global": {
    "typography": {
      "fontSizeBase": "16px",
      "fontSizeSm": "14px",
      "fontSizeLg": "20px",
      "fontWeightRegular": "400",
      "fontWeightMedium": "500",
      "fontWeightBold": "700"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "24px"
    },
    "radius": {
      "sm": "10px",
      "md": "16px",
      "lg": "24px"
    },
    "shadow": {
      "sm": "0 2px 8px rgba(15, 38, 67, 0.08)",
      "md": "0 16px 40px rgba(11, 36, 66, 0.12)",
      "lg": "0 24px 60px rgba(7, 24, 44, 0.16)"
    }
  },
  "button": {
    "borderRadius": "10px",
    "padding": "10px 16px",
    "fontSize": "14px",
    "fontWeight": "700"
  },
  "card": {
    "borderRadius": "16px",
    "shadow": "0 16px 40px rgba(11, 36, 66, 0.12)",
    "padding": "16px 24px",
    "sizeSmMinHeight": "120px",
    "sizeMdMinHeight": "160px",
    "sizeLgMinHeight": "220px"
  },
  "modal": {
    "borderRadius": "24px",
    "padding": "18px 20px",
    "sizeSmWidth": "420px",
    "sizeMdWidth": "620px",
    "sizeLgWidth": "860px"
  },
  "table": {
    "cellPadding": "14px 14px",
    "fontSize": "15px"
  },
  "form": {
    "inputBorderRadius": "10px",
    "inputPadding": "10px 12px",
    "inputFontSize": "16px",
    "inputHeight": "40px"
  },
  "layout": {
    "containerMaxWidth": "1320px"
  }
}